# /etc/whodatjet.env  (mode 0640, root:whodatjet). Written by deploy/install.sh.
WHODATJET_DATA_DIR=/var/lib/whodatjet
WHODATJET_PROFILE=medium
WHODATJET_API_HOST=127.0.0.1
WHODATJET_API_PORT=8000
UVICORN_WORKERS=4
UVICORN_LIMIT_CONCURRENCY=24
SQLITE_MMAP_SIZE=1073741824
SQLITE_CACHE_SIZE=262144
WHODATJET_STALE_DAYS=4
WHODATJET_GAP_THRESHOLD_DAYS=2
# Archive store: "s3" (settings in /etc/whodatjet/archive-store.env) or "filesystem"
WHODATJET_ARCHIVE_BACKEND=s3
# WHODATJET_ARCHIVE_DIR=/var/lib/whodatjet/archives
# Fallback Slack incoming webhook; the admin console's Notifications page takes precedence:
# WHODATJET_SLACK_WEBHOOK_URL=
# Admin console: a separate process. Publish it through a reverse proxy; it is served under /admin by default.
WHODATJET_ADMIN_PREFIX=/admin
WHODATJET_ADMIN_HOST=127.0.0.1
WHODATJET_ADMIN_PORT=8001
# Public URLs shown in Slack messages and the Monitoring page; leave unset to derive from the request.
# WHODATJET_ADMIN_URL=https://aircraft.example.org/admin
# WHODATJET_API_URL=https://aircraft.example.org
