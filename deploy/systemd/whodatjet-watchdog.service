[Unit]
Description=WhoDatJet: health, staleness and disk checks
Documentation=https://github.com/xDecisionSystems/WhoDatJet
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=whodatjet
Group=whodatjet
EnvironmentFile=/etc/whodatjet.env
EnvironmentFile=-/etc/whodatjet/archive-store.env
Environment=WHODATJET_LOG_FORMAT=json
ExecStart=/opt/whodatjet/current/.venv/bin/whodatjet watchdog
TimeoutStartSec=2min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/whodatjet
UMask=0077
