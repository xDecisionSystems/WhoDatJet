[Unit]
Description=WhoDatJet: online backup of whodatjet.db and admin.db
OnFailure=whodatjet-alert@%n.service

[Service]
Type=oneshot
User=whodatjet
Group=whodatjet
EnvironmentFile=/etc/whodatjet.env
Environment=WHODATJET_LOG_FORMAT=json
ExecStart=/opt/whodatjet/current/.venv/bin/whodatjet backup --keep 14
Nice=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/whodatjet
UMask=0077
