[Unit]
Description=WhoDatJet admin console
Documentation=https://github.com/xDecisionSystems/WhoDatJet
Wants=network-online.target
After=network-online.target
OnFailure=whodatjet-alert@%n.service

[Service]
Type=exec
User=whodatjet
Group=whodatjet
EnvironmentFile=/etc/whodatjet.env
EnvironmentFile=-/etc/whodatjet/archive-store.env
Environment=WHODATJET_LOG_FORMAT=json
Environment=WHODATJET_ADMIN_PORT=8001
ExecStart=/opt/whodatjet/current/.venv/bin/whodatjet serve-admin
Restart=on-failure
RestartSec=5
# Admin state lives in admin.db; the console never writes registry data and needs no privileges.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/whodatjet
UMask=0077

[Install]
WantedBy=multi-user.target
